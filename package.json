{
  "name": "tinker-p4t",
  "version": "0.0.755",
  "description": "secret...",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "deploy-app": "cd dist; ln -s ../.vercel; vc --prod",
    "release": "pnpm bump && pnpm build && pnpm deploy-app",
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"pnpm:twx --watch\" \"pnpm:start\"",
    "twx": "twx",
    "start": "vite",
    "cc": "prettier --check './src/**/*.{css,pcss,js,jsx,ts,tsx}'",
    "format": "prettier --write './src/**/*.{css,pcss,js,jsx,ts,tsx}'",
    "spell": "cspell './**/*.{js,jsx,ts,tsx}'",
    "build": "pnpm twx; pnpm format; tsc && vite build",
    "preview": "vite preview",
    "open": "open https://tinker-p4t.vercel.app"
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@preact/signals": "2.11.4",
    "autoprefixer": "10.6.2",
    "bumpp": "12.3.0",
    "concurrently": "10.0.7",
    "cspell": "10.4.1",
    "magic-string": "1.4.5",
    "only-allow": "1.2.2",
    "pettier": "1.1.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "proto-tailwindcss-clrs": "0.0.577",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "yoctocolors": "2.2.0"
  },
  "packageManager": "pnpm@12.18.0"
}
